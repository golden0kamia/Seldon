# Identifiants de Seldon — copiez ce fichier en .env (à côté de config.yaml),
# remplissez-le puis : chmod 600 .env
# .env n'est jamais commité ; une variable déjà exportée dans le shell l'emporte.

# Home Assistant : jeton d'accès longue durée (profil → Sécurité)
HA_TOKEN=

# Nextcloud (outil nextcloud, WebDAV) : adresse, identifiant et mot de passe
# d'application dans NEXTCLOUD_PASSWORD
# (Paramètres personnels > Sécurité > Créer un mot de passe d'application)
NEXTCLOUD_HOST=https://cloud.example.com
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# Feishin : identifiants du serveur « Remote control » (Paramètres > Général)
FEISHIN_USERNAME=
FEISHIN_PASSWORD=

# Cerveau Claude (brain: claude) : clé API Anthropic (inutile avec auth: abonnement)
ANTHROPIC_API_KEY=

# Cerveau OpenAI (brain: openai) : clé API OpenAI
OPENAI_API_KEY=
