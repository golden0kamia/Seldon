# Identifiants de Seldon — copiez ce fichier en .env (à côté de config.yaml),
# remplissez-le puis : chmod 600 .env
# .env n'est jamais commité ; une variable déjà exportée dans le shell l'emporte.

# Home Assistant : jeton d'accès longue durée (profil → Sécurité)
HA_TOKEN=

# Feishin : identifiants du serveur « Remote control » (Paramètres > Général)
FEISHIN_USERNAME=
FEISHIN_PASSWORD=

# Cerveau Claude (brain: claude) : clé API Anthropic
ANTHROPIC_API_KEY=
